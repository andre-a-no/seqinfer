{
  "name": "sequential-analysis",
  "version": "0.3.0",
  "description": "TypeScript executor for sequential-analysis runs: the same procedures, checkpoints and observation logs as the Python library, bit for bit where the arithmetic allows.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": { "sequential-analysis": "dist/src/cli.js" },
  "files": ["dist/src", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js"
  },
  "repository": { "type": "git", "url": "https://github.com/andre-a-no/sequential-analysis" },
  "keywords": ["sequential analysis", "SPRT", "anytime-valid", "A/B testing", "change detection", "checkpoint"],
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
